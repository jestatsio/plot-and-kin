# Advanced environment overrides. The application does not automatically load .env.
# Guided setup is the primary path. Never commit credentials or paste them into chat.
# Real research persists locally without an Astra account or model API key.
PK_STORAGE=local
# PK_SETTINGS_DIR=/absolute/path/to/plot-and-kin/settings
# PK_LIBRARY_DIR=/absolute/path/to/plot-and-kin
# PK_IMPORT_DIR=/absolute/path/to/plot-and-kin/imports

# Optional Astra. Guided `setup --connect-astra` saves credentials securely and keeps
# local research as the default. Move individual cases only after explicit approval.
# PK_STORAGE=astra chooses Astra as the installation default without moving local cases.
# ASTRA_DB_API_ENDPOINT=https://YOUR-DATABASE-ID-us-east-2.apps.astra.datastax.com
# ASTRA_DB_APPLICATION_TOKEN=
# ASTRA_DB_KEYSPACE=default_keyspace

# Optional custom model processing. Prefer guided `setup --processing`.
# Leave PK_PROVIDER unset for public records and embedded-text workflows.
# PK_PROVIDER=openai
# PK_MODEL=YOUR_VISION_CAPABLE_MODEL
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PK_INPUT_USD_PER_MILLION=REPLACE_WITH_VERIFIED_MODEL_PRICE
# PK_OUTPUT_USD_PER_MILLION=REPLACE_WITH_VERIFIED_MODEL_PRICE
# PK_PRICING_DATE=YYYY-MM-DD
# PK_MAX_INPUT_TOKENS=65536
